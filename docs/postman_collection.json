{
  "info": {
    "name": "Blogging Platform IV",
    "description": "REST and GraphQL requests for the Blogging Platform IV lab. Start the app with .\\mvnw.cmd spring-boot:run, import this file, and run the folders from top to bottom. The create requests save their IDs into collection variables for the later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId", "value": "" },
    { "key": "username", "value": "" },
    { "key": "tagId", "value": "" },
    { "key": "tagName", "value": "" },
    { "key": "postId", "value": "" },
    { "key": "commentId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Users",
      "item": [
        {
          "name": "Create user",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.collectionVariables.set('userId', pm.response.json().data.id);",
            "pm.collectionVariables.set('username', pm.response.json().data.username);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"author_{{$timestamp}}\",\n  \"email\": \"author_{{$timestamp}}@example.test\",\n  \"displayName\": \"Demo Author\"\n}" },
            "description": "Expect 201. The email is not in the response (@JsonIgnore)."
          }
        },
        {
          "name": "List users",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] } }
        },
        {
          "name": "Get user (cached)",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "description": "Send it twice: the second answer comes from the 'users' cache."
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"updated_{{$timestamp}}@example.test\",\n  \"displayName\": \"Updated Author\"\n}" },
            "description": "Expect 200. @CacheEvict removes the cached copy of this user."
          }
        }
      ]
    },
    {
      "name": "2. Tags",
      "item": [
        {
          "name": "Create tag",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.collectionVariables.set('tagId', pm.response.json().data.id);",
            "pm.collectionVariables.set('tagName', pm.response.json().data.name);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/tags", "host": ["{{baseUrl}}"], "path": ["api", "tags"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"spring-{{$timestamp}}\"\n}" },
            "description": "Expect 201."
          }
        },
        {
          "name": "List tags (cached)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/tags", "host": ["{{baseUrl}}"], "path": ["api", "tags"] } }
        }
      ]
    },
    {
      "name": "3. Posts",
      "item": [
        {
          "name": "Create post",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.collectionVariables.set('postId', pm.response.json().data.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/posts?authorId={{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "posts"], "query": [{ "key": "authorId", "value": "{{userId}}" }] },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Spring Data JPA {{$timestamp}}\",\n  \"body\": \"Repositories make data access simple.\",\n  \"tagIds\": [{{tagId}}]\n}" },
            "description": "Expect 201. The response shows the author and the tags."
          }
        },
        {
          "name": "Rollback demo - post with a missing tag (expect 404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/posts?authorId={{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "posts"], "query": [{ "key": "authorId", "value": "{{userId}}" }] },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Rollback demo {{$timestamp}}\",\n  \"body\": \"This post must not be saved.\",\n  \"tagIds\": [{{tagId}}, 999999]\n}" },
            "description": "PostService.create inserts the post, then fails on tag 999999. The transaction is rolled back, so the post is NOT saved. Run 'List posts' before and after: totalElements does not change."
          }
        },
        {
          "name": "Same title again (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/posts?authorId={{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "posts"], "query": [{ "key": "authorId", "value": "{{userId}}" }] },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Same title\",\n  \"body\": \"Send this request twice: the second time the unique title is refused.\"\n}" }
          }
        },
        {
          "name": "List posts - page, size, sort",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts?page=0&size=5&sort=createdAt,desc",
              "host": ["{{baseUrl}}"], "path": ["api", "posts"],
              "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "5" }, { "key": "sort", "value": "createdAt,desc" }]
            },
            "description": "Pageable: page starts at 0, size is at most 100, sort is field,direction (createdAt, title, id...)."
          }
        },
        {
          "name": "Search posts by keyword (JPQL)",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts?keyword=spring&sort=title,asc",
              "host": ["{{baseUrl}}"], "path": ["api", "posts"],
              "query": [{ "key": "keyword", "value": "spring" }, { "key": "sort", "value": "title,asc" }]
            },
            "description": "Runs PostRepository.searchByKeyword (JPQL)."
          }
        },
        {
          "name": "Posts of one author (derived query)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/posts/author/{{username}}", "host": ["{{baseUrl}}"], "path": ["api", "posts", "author", "{{username}}"] } }
        },
        {
          "name": "Posts with one tag (derived query)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/posts/tag/{{tagName}}", "host": ["{{baseUrl}}"], "path": ["api", "posts", "tag", "{{tagName}}"] } }
        },
        {
          "name": "Get post (cached)",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/api/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["api", "posts", "{{postId}}"] },
            "description": "Send it twice: the second answer comes from the 'posts' cache (see the timing in the console)."
          }
        },
        {
          "name": "Update post",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["api", "posts", "{{postId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Spring Data JPA {{$timestamp}} (edited)\",\n  \"body\": \"Updated body.\",\n  \"tagIds\": [{{tagId}}]\n}" },
            "description": "Expect 200. @CacheEvict removes this post from the cache."
          }
        }
      ]
    },
    {
      "name": "4. Comments and reviews (MongoDB)",
      "item": [
        {
          "name": "Add comment",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.collectionVariables.set('commentId', pm.response.json().data.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/posts/{{postId}}/comments?authorId={{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "posts", "{{postId}}", "comments"], "query": [{ "key": "authorId", "value": "{{userId}}" }] },
            "body": { "mode": "raw", "raw": "{\n  \"body\": \"Great article.\"\n}" }
          }
        },
        {
          "name": "List comments - one page",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}/comments?page=0&size=5",
              "host": ["{{baseUrl}}"], "path": ["api", "posts", "{{postId}}", "comments"],
              "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "5" }]
            }
          }
        },
        {
          "name": "Update comment",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/posts/{{postId}}/comments/{{commentId}}", "host": ["{{baseUrl}}"], "path": ["api", "posts", "{{postId}}", "comments", "{{commentId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"body\": \"Edited comment.\"\n}" }
          }
        },
        {
          "name": "Add review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/posts/{{postId}}/reviews?reviewerId={{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "posts", "{{postId}}", "reviews"], "query": [{ "key": "reviewerId", "value": "{{userId}}" }] },
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"text\": \"Helpful.\"\n}" },
            "description": "Send it twice: the second time answers 409, one review per user and post."
          }
        },
        {
          "name": "List reviews",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/posts/{{postId}}/reviews", "host": ["{{baseUrl}}"], "path": ["api", "posts", "{{postId}}", "reviews"] } }
        },
        {
          "name": "Dashboard",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/dashboard", "host": ["{{baseUrl}}"], "path": ["api", "dashboard"] } }
        }
      ]
    },
    {
      "name": "5. GraphQL",
      "item": [
        {
          "name": "Query - one page of posts",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] },
            "body": { "mode": "graphql", "graphql": { "query": "{\n  posts(page: 0, size: 5) {\n    totalElements\n    totalPages\n    content { id title author { username } tags { name } }\n  }\n}", "variables": "{}" } }
          }
        },
        {
          "name": "Query - post with comments and reviews",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] },
            "body": { "mode": "graphql", "graphql": { "query": "query ($id: ID!) {\n  post(id: $id) { title tags { name } }\n  comments(postId: $id, size: 5) { totalElements content { body authorName } }\n  reviews(postId: $id) { rating text }\n}", "variables": "{\n  \"id\": \"{{postId}}\"\n}" } }
          }
        },
        {
          "name": "Mutation - create tag",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] },
            "body": { "mode": "graphql", "graphql": { "query": "mutation {\n  createTag(input: { name: \"graphql-{{$timestamp}}\" }) { id name }\n}", "variables": "{}" } }
          }
        }
      ]
    },
    {
      "name": "6. Errors",
      "item": [
        {
          "name": "Invalid user - expect 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"x\",\n  \"email\": \"not-an-email\",\n  \"displayName\": \"\"\n}" }
          }
        },
        {
          "name": "Sort by unknown field - expect 400",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/posts?sort=color", "host": ["{{baseUrl}}"], "path": ["api", "posts"], "query": [{ "key": "sort", "value": "color" }] } }
        },
        {
          "name": "Unknown post - expect 404",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/posts/999999", "host": ["{{baseUrl}}"], "path": ["api", "posts", "999999"] } }
        },
        {
          "name": "Delete a user who has posts - expect 409",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] } }
        }
      ]
    },
    {
      "name": "7. Cleanup (run last)",
      "item": [
        {
          "name": "Delete comment",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/posts/{{postId}}/comments/{{commentId}}", "host": ["{{baseUrl}}"], "path": ["api", "posts", "{{postId}}", "comments", "{{commentId}}"] } }
        },
        {
          "name": "Delete post",
          "request": {
            "method": "DELETE", "header": [],
            "url": { "raw": "{{baseUrl}}/api/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["api", "posts", "{{postId}}"] },
            "description": "Deletes the post, its post_tags rows, and its comments and reviews."
          }
        },
        {
          "name": "Delete tag",
          "request": {
            "method": "DELETE", "header": [],
            "url": { "raw": "{{baseUrl}}/api/tags/{{tagId}}", "host": ["{{baseUrl}}"], "path": ["api", "tags", "{{tagId}}"] },
            "description": "Runs the native query TagRepository.removeTagFromPosts, then deletes the tag."
          }
        }
      ]
    }
  ]
}
