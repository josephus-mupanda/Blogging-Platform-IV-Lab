
type Query {
  posts(keyword: String, page: Int = 0, size: Int = 10): PostPage!
  post(id: ID!): Post
  users: [User!]!
  user(id: ID!): User
  tags: [Tag!]!
  tag(id: ID!): Tag
  comments(postId: ID!, page: Int = 0, size: Int = 10): CommentPage!
  comment(postId: ID!, id: ID!): Comment
  reviews(postId: ID!): [Review!]!
  dashboard: Dashboard
}

type Mutation {
  createUser(input: UserCreate!): User
  updateUser(id: ID!, input: UserUpdate!): User
  deleteUser(id: ID!): Boolean
  createPost(authorId: ID!, input: PostInput!): Post
  updatePost(id: ID!, input: PostInput!): Post
  deletePost(id: ID!): Boolean
  createTag(input: TagInput!): Tag
  updateTag(id: ID!, input: TagInput!): Tag
  deleteTag(id: ID!): Boolean
  addComment(postId: ID!, authorId: ID!, input: CommentInput!): Comment
  updateComment(postId: ID!, id: ID!, input: CommentInput!): Comment
  deleteComment(postId: ID!, id: ID!): Boolean
  addReview(postId: ID!, reviewerId: ID!, input: ReviewInput!): Review
}

input UserCreate { username: String!, email: String!, displayName: String! }
input UserUpdate { email: String!, displayName: String! }
input PostInput { title: String!, body: String!, tagIds: [ID!] }
input TagInput { name: String! }
input CommentInput { body: String! }
input ReviewInput { rating: Int!, text: String }

type User { id: ID!, username: String!, displayName: String! }
type Tag { id: ID!, name: String! }
type Post { id: ID!, title: String!, body: String!, author: User!, tags: [Tag!]!, createdAt: String, updatedAt: String }
type Comment { id: ID!, postId: ID!, authorId: ID!, authorName: String!, body: String!, createdAt: String! }
type Review { id: ID!, postId: ID!, reviewerId: ID!, reviewerName: String!, rating: Int!, text: String, createdAt: String! }

# A Spring Data Page: GraphQL reads content, number, size, totalElements and totalPages from it.
type PostPage { content: [Post!]!, number: Int!, size: Int!, totalElements: Long!, totalPages: Int! }
type CommentPage { content: [Comment!]!, number: Int!, size: Int!, totalElements: Long!, totalPages: Int! }

type Dashboard { users: Long!, posts: Long!, tags: Long!, comments: Long!, reviews: Long! }

scalar Long
